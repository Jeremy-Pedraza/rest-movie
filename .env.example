# ============================================
# 🔧 ENVIRONMENT CONFIGURATION
# ============================================
# Copiar este archivo a .env y configurar los valores

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=mokka-backend
APP_PORT=3000
APP_HOST=localhost
APP_URL=http://localhost:3000
API_PREFIX=api/v1
APP_DEBUG=true

# Timeout para requests HTTP (en milisegundos)
# Default: 30000 (30 segundos)
APP_REQUEST_TIMEOUT=30000

# ============================================
# DATABASE - PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=mokka_db
DB_SCHEMA=public
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ============================================
# JWT AUTHENTICATION
# ============================================
# Access Token (autenticación)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=mokka-api
JWT_AUDIENCE=mokka-client

# Refresh Token (renovación de sesión)
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_LONG_EXPIRES_IN=30d

# Reset Token (recuperación de contraseña)
JWT_RESET_SECRET=your_super_secret_reset_key_min_32_chars
JWT_RESET_EXPIRES_IN=1h

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:4200
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# ============================================
# THROTTLER (Rate Limiting)
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ============================================
# SWAGGER
# ============================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=Mokka Backend API
SWAGGER_DESCRIPTION=API REST Documentation
SWAGGER_VERSION=1.0
SWAGGER_PATH=docs

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Logging en base de datos
# Valores: all | warnings | errors | none
# - all: Guarda todo (success + warnings + errors)
# - warnings: Guarda solo 4xx y 5xx
# - errors: Guarda solo 5xx
# - none: No guarda nada en BD (solo consola)
LOG_DB_LEVEL=all

# Logging en consola (true | false)
LOG_CONSOLE=true

# Rutas a ignorar del logging (separadas por coma)
LOG_IGNORE_PATHS=/health,/health/ready,/favicon.ico

# ============================================
# BULL QUEUE
# ============================================
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=

# ============================================
# EMAIL (opcional)
# ============================================
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@mokka.com

# ============================================
# STORAGE (opcional)
# ============================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
