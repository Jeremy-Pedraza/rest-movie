# ============================================
# 🔧 ENVIRONMENT CONFIGURATION
# ============================================
# Copiar este archivo a .env y configurar los valores

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=mokka-backend
APP_PORT=3000
APP_HOST=localhost
APP_URL=http://localhost:3000
API_PREFIX=api/v1
APP_DEBUG=true

# Timeout para requests HTTP (en milisegundos)
# Default: 30000 (30 segundos)
APP_REQUEST_TIMEOUT=30000

# ============================================
# DATABASE - PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=mokka_db
DB_SCHEMA=public
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ============================================
# JWT AUTHENTICATION
# ============================================
# Access Token (autenticación)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=mokka-api
JWT_AUDIENCE=mokka-client

# Refresh Token (renovación de sesión)
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_LONG_EXPIRES_IN=30d

# Reset Token (recuperación de contraseña)
JWT_RESET_SECRET=your_super_secret_reset_key_min_32_chars
JWT_RESET_EXPIRES_IN=1h

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# CORS
# ============================================
# ⚠️ DEPRECADO: CORS_ORIGIN ya NO se usa
# Los dominios permitidos ahora se gestionan en:
# src/config/security/security-whitelist.json
#
# Para agregar dominios, edita el archivo JSON:
# - Desarrollo: localhost, 127.0.0.1
# - Producción: https://tudominio.com
#
# CORS_ORIGIN=http://localhost:3000,http://localhost:4200

# Métodos HTTP permitidos
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Permitir credenciales (cookies, tokens)
CORS_CREDENTIALS=true

# ============================================
# THROTTLER (Rate Limiting)
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ============================================
# SWAGGER
# ============================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=Mokka Backend API
SWAGGER_DESCRIPTION=API REST Documentation
SWAGGER_VERSION=1.0
SWAGGER_PATH=docs

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Logging en base de datos
# Valores: all | warnings | errors | none
# - all: Guarda todo (success + warnings + errors)
# - warnings: Guarda solo 4xx y 5xx
# - errors: Guarda solo 5xx
# - none: No guarda nada en BD (solo consola)
LOG_DB_LEVEL=all

# Logging en consola (true | false)
LOG_CONSOLE=true

# Rutas a ignorar del logging (separadas por coma)
LOG_IGNORE_PATHS=/health,/health/ready,/favicon.ico

# ============================================
# BULL QUEUE
# ============================================
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=

# ============================================
# NOTIFICATIONS - Email (Nodemailer)
# ============================================
# Proveedor SMTP para emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Mokka Backend

# Límites de envío (por minuto)
EMAIL_RATE_LIMIT=100

# ============================================
# NOTIFICATIONS - SMS (Twilio)
# ============================================
# Twilio credentials (opcional - solo si usas SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMS Rate limiting (por minuto)
SMS_RATE_LIMIT=10

# ============================================
# NOTIFICATIONS - Push (Firebase)
# ============================================
# Firebase Cloud Messaging (opcional - solo si usas Push)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# Push Rate limiting (por minuto)
PUSH_RATE_LIMIT=500

# ============================================
# NOTIFICATIONS - General
# ============================================
# Habilitar/deshabilitar canales
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false

# Retry configuration
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=1000

# Queue names
NOTIFICATION_QUEUE_NAME=notifications
EMAIL_QUEUE_NAME=email-notifications
SMS_QUEUE_NAME=sms-notifications
PUSH_QUEUE_NAME=push-notifications

# ============================================
# STORAGE (opcional)
# ============================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# ============================================
# TASKS MODULE - Tareas Programadas
# ============================================
# Habilitar/deshabilitar todo el módulo
TASKS_ENABLED=true

# Job: Cleanup (limpieza de soft-deleted)
# Cron: Diario a las 3 AM
TASKS_CLEANUP_ENABLED=true
TASKS_CLEANUP_CRON="0 3 * * *"
TASKS_CLEANUP_RETENTION_DAYS=30
# Tablas a limpiar (vacío = todas con soft-delete)
# TASKS_CLEANUP_TABLES=users,sessions

# Job: Backup (respaldo de tablas críticas)
# Cron: Domingos a las 2 AM
TASKS_BACKUP_ENABLED=true
TASKS_BACKUP_CRON="0 2 * * 0"
TASKS_BACKUP_TABLES=users,roles,permissions
TASKS_BACKUP_DIR=backups
TASKS_BACKUP_KEEP=4

# Job: Session Cleanup (limpieza de sesiones expiradas)
# Cron: Cada 15 minutos
TASKS_SESSION_CLEANUP_ENABLED=true
TASKS_SESSION_CLEANUP_CRON="*/15 * * * *"

# Job: Log Cleanup (limpieza de logs debug/verbose)
# Cron: Diario a las 4 AM
TASKS_LOG_CLEANUP_ENABLED=true
TASKS_LOG_CLEANUP_CRON="0 4 * * *"
TASKS_LOG_CLEANUP_RETENTION_DAYS=7
# Niveles a limpiar (separados por coma)
TASKS_LOG_CLEANUP_LEVELS=debug,verbose

# Job: Cache Warmup (precalentamiento de cache)
# Cron: Diario a las 6 AM
TASKS_CACHE_WARMUP_ENABLED=true
TASKS_CACHE_WARMUP_CRON="0 6 * * *"
TASKS_CACHE_WARMUP_TTL=3600
