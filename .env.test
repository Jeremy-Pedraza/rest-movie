# ============================================
# 🧪 TEST ENVIRONMENT
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=test
APP_NAME=rest-backend-test
APP_PORT=3001
APP_HOST=localhost
APP_URL=http://localhost:3001
API_PREFIX=api/v1
APP_DEBUG=false

# ============================================
# DATABASE - PostgreSQL (Test Database)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DATABASE=rest_test_db
DB_SCHEMA=public
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL=3600

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=test_jwt_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=test_refresh_secret_key_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_LONG_EXPIRES_IN=30d
JWT_ISSUER=rest-api-test
JWT_AUDIENCE=rest-client-test

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=4
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# ============================================
# THROTTLER (Rate Limiting) - Disabled for tests
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# ============================================
# SWAGGER
# ============================================
SWAGGER_ENABLED=false
SWAGGER_TITLE=Rest Backend API Test
SWAGGER_DESCRIPTION=API REST Documentation Test
SWAGGER_VERSION=1.0
SWAGGER_PATH=docs

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=error
LOG_DIR=logs/test
LOG_MAX_SIZE=20m
LOG_MAX_FILES=7d

# Logging en base de datos - Deshabilitado para tests
LOG_DB_LEVEL=none
LOG_CONSOLE=false
LOG_IGNORE_PATHS=/health,/health/ready,/favicon.ico

# ============================================
# BULL QUEUE
# ============================================
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=
